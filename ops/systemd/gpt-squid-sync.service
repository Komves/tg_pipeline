# REVIEW ONLY: offline privileged synchronizer. No network listener
[Unit]
Description=Apply authorized GPT-only user projection to Squid htpasswd
ConditionPathExists=/var/lib/squid-gpt-agent/projection/users
ConditionPathExists=/etc/squid-gpt/users

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/vesya-gpt-agent/gpt_apply_projection.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/etc/squid-gpt /var/lib/squid-gpt-sync
LockPersonality=true
