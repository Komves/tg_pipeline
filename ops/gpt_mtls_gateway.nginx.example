# REVIEW-ONLY TEMPLATE. DO NOT INCLUDE BEFORE A PORT, NAME, CERTIFICATE
# AND CHANGE IMPACT CHECK. Leave live 443 / 4453 / 4454 / 4455 untouched.
# Requires two independent controls: client mTLS + X-GPT-Agent-Token.
# Provision private CA, client cert for Render and server cert securely.
server {
    listen 0.0.0.0:REVIEW_NEW_PORT ssl;
    server_name MANAGEMENT_ONLY_FQDN;

    ssl_certificate /SECURE/PATH/server-fullchain.pem;
    ssl_certificate_key /SECURE/PATH/server-key.pem;
    ssl_client_certificate /SECURE/PATH/trusted-client-ca.pem;
    ssl_verify_client on;
    ssl_verify_depth 2;
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log off;  # keep client and credential information out of access logs
    client_max_body_size 4k;
    proxy_read_timeout 15s;
    proxy_connect_timeout 3s;

    location ~ ^/v1/(create_user|get_user_status|disable_user|enable_user|rotate_password|get_service_status)$ {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:43141;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header X-GPT-Agent-Token $http_x_gpt_agent_token;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Connection "close";
    }
    location / { return 404; }
}
